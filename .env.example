# ─────────────────────────────────────────────────────────────
# DIABETES À MESA (Sabor Equilibrado) — variáveis de ambiente
# Copie para .env (local) e cadastre na Vercel (Settings → Environment Variables).
# NUNCA commite valores reais. Gere segredos NOVOS (não reutilize os de outros projetos).
# ─────────────────────────────────────────────────────────────

# Banco (PostgreSQL / Neon) — exclusivo deste projeto. Pooled para a app, direta para migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# URL pública (sem barra final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Segredos — gere com: openssl rand -hex 32
AUTH_SECRET=
DATA_ENCRYPTION_KEY=      # AES-256 dos dados do crediário. NÃO troque depois de haver pedidos
CRON_SECRET=              # protege /api/cron/* (Vercel Cron e GitHub Actions)

# Primeiro administrador (bootstrap): npm run admin:hash -- "senha-forte-12+"  → cole a saída (b64:...)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# BravoPay — PIX (só no servidor)
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=  # segredo do webhook DESTE endpoint (cadastre /api/webhooks/bravopay no painel)
BRAVOPAY_PRODUCT_ID=      # opcional
BRAVOPAY_BASE_URL=        # opcional (padrão https://bravopay.club/api/v1)
BRAVOPAY_MODE=            # "mock" = PIX fictício para testes (bloqueado em produção)

# E-mails transacionais (Resend) — domínio verificado na Resend
RESEND_API_KEY=
EMAIL_FROM=               # ex.: Diabetes à Mesa <acesso@seudominio.com.br>
EMAIL_REPLY_TO=           # opcional
EMAIL_PROVIDER=           # "console" = só registra no log (desenvolvimento)

# Meta Pixel / Conversions API (IDs também configuráveis no admin)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKENS=         # pixelId:token,pixelId:token
META_ACCESS_TOKEN=        # alternativa: um token para todos os pixels
META_TEST_EVENT_CODE=     # opcional: código de teste do Gerenciador de Eventos

# Google Analytics 4 (também no admin)
NEXT_PUBLIC_GA_ID=

# Captura de e-mail do quiz (/quiz) — URL do webhook da sua ferramenta (Brevo, ActiveCampaign, n8n, Google Sheets…)
# Sem isso o quiz funciona, mas os e-mails NÃO são capturados. Plugue antes de rodar anúncios.
NEXT_PUBLIC_LEAD_WEBHOOK=

# Otimização de imagens da Vercel (opt-in, consome cota)
IMAGE_OPTIMIZATION=
